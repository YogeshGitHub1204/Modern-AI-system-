# ==============================================================================
# CONCEPT: Environment Configuration Template
# This file defines all environment variables required by the application.
# Copy this file to '.env' and fill in your actual credentials.
# The application reads these variables via python-dotenv and Pydantic Settings.
# ==============================================================================

# --- Local Open-Source LLM Configuration (Ollama) ---
# The name of the local Ollama model to load (e.g., 'llama3.2', 'mistral', 'qwen2.5', 'deepseek-r1')
OLLAMA_MODEL=llama3.2

# The HTTP endpoint where your local Ollama daemon is listening (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Embedding model name in Ollama (e.g., 'nomic-embed-text' or 'all-minilm')
OLLAMA_EMBED_MODEL=nomic-embed-text


# --- Vector Database Configuration (Pinecone for RAG) ---
# Your Pinecone API key generated from https://app.pinecone.io/
# If left blank, the application will automatically fall back to an in-memory vector store for testing.
PINECONE_API_KEY=your_pinecone_api_key_here

# The name of the Pinecone vector index where chunked embeddings are stored
PINECONE_INDEX_NAME=ai-systems-knowledge-base

# Pinecone Cloud & Region (e.g., 'aws', 'us-east-1')
PINECONE_ENVIRONMENT=us-east-1

# Embedding dimension (must match embedding model, e.g., 384 for minilm, 768 for nomic-embed-text, 1536 for OpenAI)
PINECONE_DIMENSION=768

# Distance metric for vector search: 'cosine', 'euclidean', or 'dotproduct'
PINECONE_METRIC=cosine


# --- Web Application & API Settings ---
# Host and port for the FastAPI web server
WEB_HOST=0.0.0.0
WEB_PORT=8000
DEBUG=true


# --- Model Context Protocol (MCP) Server Settings ---
# Port for running the MCP server over SSE (Server-Sent Events) or HTTP
MCP_HOST=127.0.0.1
MCP_PORT=8080
MCP_TRANSPORT=stdio
